# Copy to .env and adjust. Never commit real secrets.

# ---- backend
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://homecare:homecare@localhost:5433/homecare
DATABASE_URL_TEST=postgres://homecare:homecare@localhost:5433/homecare_test
# Leave empty to run background jobs inline (no Redis needed). Set e.g. redis://localhost:6379 to use BullMQ.
REDIS_URL=
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
RISK_ENGINE_URL=http://localhost:8000
SIMULATOR_URL=http://localhost:4100
SENSOR_OFFLINE_SECONDS=15
ACK_TIMEOUT_SECONDS=60
ALERT_COOLDOWN_SECONDS=60
RAPID_INCREASE_THRESHOLD=20
NOTE_WINDOW_MINUTES=120
LOG_LEVEL=info

# ---- phone alerts via Telegram (optional; see README "Phone alerts")
# 1. In Telegram, talk to @BotFather -> /newbot -> copy the token here.
# 2. Start the backend, send /start to your bot: it replies with your chat id -> put it in TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# optional second chat (family / on-call nurse) that receives escalations
TELEGRAM_ESCALATION_CHAT_ID=
# account used when a caregiver taps "Acknowledge" in Telegram
TELEGRAM_USER_EMAIL=anita@homecare.demo
DASHBOARD_URL=http://localhost:5173

# ---- shared between backend and simulator
DEVICE_API_KEY=change-me-device-key
SIMULATOR_CONTROL_TOKEN=change-me-simulator-token

# ---- sensor simulator
BACKEND_URL=http://localhost:4000
SIMULATOR_PORT=4100
SIMULATOR_TICK_MS=2000

# ---- local PostgreSQL (npm run db:start)
LOCAL_PG_PORT=5433
